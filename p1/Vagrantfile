Vagrant.configure("2") do |config|
  config.vm.box              = "bento/ubuntu-26.04"
  config.vm.box_version      = "202606.01.0"
  config.vm.box_check_update = false

  servers = [
    { hostname: "jcaroS",  ip: "192.168.56.110", memory: 512, role: "server" },
    { hostname: "jcaroSW", ip: "192.168.56.111", memory: 512,  role: "agent" },
  ]

  servers.each do |machine|
    config.vm.define machine[:hostname] do |node|
      node.vm.hostname = machine[:hostname]
      node.vm.network "private_network", ip: machine[:ip]

      node.vm.provider "virtualbox" do |vb|
        vb.name   = machine[:hostname]
        vb.memory = machine[:memory]
        vb.cpus   = 1
        vb.linked_clone = true
      end

      # TODO: node.vm.provision "shell", path: "scripts/#{machine[:role]}.sh"
    end
  end
end